# Shadow Liquidity Rebalancing Bot Configuration

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=@your_bot_username

# Security - User Access Control
# Comma-separated list of Telegram user IDs allowed to use the bot
# Leave empty to allow all users (NOT RECOMMENDED)
ALLOWED_USER_IDS=123456789,987654321

# Admin Notifications
# Comma-separated list of Telegram user IDs to receive admin notifications
ADMIN_CHAT_IDS=123456789

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# MetaMask Configuration (can be provided via /connect command)
METAMASK_PHRASE=your twelve word seed phrase goes here
METAMASK_PASSWORD=your_metamask_password

# Browser Configuration
EXTENSION_PATH=metamask_extension
USER_DATA_DIR=user_profile
HEADLESS=false
START_MAXIMIZED=true
COLOR_SCHEME=dark

# Pool Monitoring Settings
MONITOR_INTERVAL=60
REBALANCE_THRESHOLD=90
BALANCE_TOLERANCE=2
POLL_INTERVAL=1

# Shadow.so Configuration
SHADOW_BASE_URL=https://www.shadow.so/liquidity/
DEFAULT_RANGE_TYPES=passive,wide,narrow,aggressive,insane

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Error Recovery & Reliability
MAX_BROWSER_RETRIES=3
BROWSER_RESTART_DELAY=30
TRANSACTION_TIMEOUT=120
MAX_REBALANCE_RETRIES=2

# Notifications
ENABLE_NOTIFICATIONS=true

# Logging
LOG_DIR=logs

# =============================================================================
# SETTING DESCRIPTIONS
# =============================================================================

# TELEGRAM_BOT_TOKEN: Get from @BotFather on Telegram
# ALLOWED_USER_IDS: Find your user ID by messaging @userinfobot
# ADMIN_CHAT_IDS: User IDs who receive error/success notifications
# MONITOR_INTERVAL: How often to check pools (seconds)
# REBALANCE_THRESHOLD: Trigger rebalancing when price is X% close to range boundary
# BALANCE_TOLERANCE: Acceptable token balance difference percentage
# HEADLESS: Run browser without GUI (true/false)
# MAX_BROWSER_RETRIES: How many times to restart browser on failure
# TRANSACTION_TIMEOUT: Max time to wait for MetaMask transactions (seconds) 